# Optional runtime configuration.
# Do not put real secrets in this file.

RISK_RADAR_HOST=0.0.0.0
RISK_RADAR_PORT=8765

# Default exchange suffix for 6-digit symbols (e.g., .KS for Korea).
RISK_RADAR_DEFAULT_EXCHANGE=.KS

# Comma-separated list of supported valuation currencies.
RISK_RADAR_VALUATION_CURRENCIES=KRW

# FRED API key for macro data (V1.5).
# Free sign-up: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
